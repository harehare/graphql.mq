# GraphQL schema parser implemented in mq
# Parses SDL (Schema Definition Language): types, enums, interfaces, inputs, unions, scalars
# https://spec.graphql.org/

# ─── internal ─────────────────────────────────────────────────────────────────

def _gql_strip_comments(s):
  let lines = split(s, "\n")
  | map(lines, fn(l):
      let m = capture(l, "^(?P<code>[^\"#]*)(?:#.*)?$")
      | if (is_none(m["code"])): l else: trim(m["code"])
    ;)
  | join("\n")
end

def _gql_parse_type_ref(s):
  let t = trim(s)
  | if (starts_with(t, "[") && ends_with(t, "]!")):
      {"type": slice(t, 1, len(t) - 2), "required": true, "list": true}
    elif (starts_with(t, "[") && ends_with(t, "]")):
      {"type": slice(t, 1, len(t) - 1), "required": false, "list": true}
    elif (ends_with(t, "!")):
      {"type": slice(t, 0, len(t) - 1), "required": true, "list": false}
    else:
      {"type": t, "required": false, "list": false}
end

def _gql_parse_field(line):
  let l = trim(line)
  | let m = capture(l, "^(?P<name>[A-Za-z_][A-Za-z0-9_]*)(?P<args>\\([^)]*\\))?:\\s*(?P<type>[A-Za-z_\\[\\]!]+)")
  | if (is_none(m["name"])):
      None
    else:
      do
        let type_ref = _gql_parse_type_ref(m["type"])
        | let args = if (is_none(m["args"]) || len(trim(m["args"])) <= 2):
              []
            else:
              do
                let inner = slice(trim(m["args"]), 1, len(trim(m["args"])) - 1)
                | let arg_parts = split(inner, ",\\s*")
                | map(arg_parts, fn(a):
                    let am = capture(trim(a), "^(?P<n>[A-Za-z_][A-Za-z0-9_]*):\\s*(?P<t>[A-Za-z_\\[\\]!]+)")
                    | if (is_none(am["n"])): None
                      else: {"name": am["n"], "type": _gql_parse_type_ref(am["t"])}
                  ;)
                | filter(fn(a): not(is_none(a));)
              end
        | {"name": m["name"], "type": type_ref, "args": args}
      end
end

def _gql_extract_block(s, keyword):
  let pattern = "(?s)" + keyword + "\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(?:implements|=)[^{]*)?\\s*\\{([^}]*)\\}"
  | let matches = regex_match(s, "[A-Za-z_][A-Za-z0-9_]*\\s*(?:implements[^{]*)?\\{[^}]*\\}")
  | matches
end

def _gql_parse_type_def(block, kind):
  let m = capture(block, "^(?P<name>[A-Za-z_][A-Za-z0-9_]*)(?:\\s+implements\\s+(?P<ifaces>[A-Za-z_&\\s]+))?\\s*\\{(?P<body>[^}]*)\\}")
  | if (is_none(m["name"])):
      None
    else:
      do
        let name_ = trim(m["name"])
        | let body = if (is_none(m["body"])): "" else: m["body"]
        | let field_lines = filter(split(body, "\n"), fn(l): len(trim(l)) > 0;)
        | let fields = filter(map(field_lines, fn(l): _gql_parse_field(l);), fn(f): not(is_none(f));)
        | let ifaces = if (is_none(m["ifaces"]) || len(trim(m["ifaces"])) == 0):
              []
            else:
              filter(map(split(trim(m["ifaces"]), "&\\s*"), fn(i): trim(i);), fn(i): len(i) > 0;)
        | {"kind": kind, "name": name_, "fields": fields, "interfaces": ifaces}
      end
end

def _gql_parse_enum_def(block):
  let m = capture(block, "^(?P<name>[A-Za-z_][A-Za-z0-9_]*)\\s*\\{(?P<body>[^}]*)\\}")
  | if (is_none(m["name"])):
      None
    else:
      do
        let values = filter(
          map(split(m["body"], "\n"), fn(l): trim(l);),
          fn(v): len(v) > 0 && is_regex_match(v, "^[A-Za-z_][A-Za-z0-9_]*$")
        ;)
        | {"kind": "enum", "name": trim(m["name"]), "values": values}
      end
end

def _gql_parse_union_def(block):
  let m = capture(block, "^(?P<name>[A-Za-z_][A-Za-z0-9_]*)\\s*=\\s*(?P<members>.+)")
  | if (is_none(m["name"])):
      None
    else:
      do
        let members = map(split(m["members"], "\\s*\\|\\s*"), fn(v): trim(v);)
        | {"kind": "union", "name": trim(m["name"]), "members": filter(members, fn(m_): len(m_) > 0;)}
      end
end

def _gql_find_defs(s, keyword, parser):
  let pattern = keyword + "\\s+[A-Za-z_][A-Za-z0-9_][^{]*\\{[^}]*\\}"
  | let raw_matches = regex_match(s, pattern)
  | let defs = map(raw_matches, fn(blk):
      let inner = trim(replace(blk, keyword + " ", ""))
      | parser(inner)
    ;)
  | filter(defs, fn(d): not(is_none(d));)
end

def _gql_find_scalars(s):
  let matches = regex_match(s, "scalar\\s+[A-Za-z_][A-Za-z0-9_]*")
  | map(matches, fn(m_):
      let name_ = trim(replace(m_, "scalar ", ""))
      | {"kind": "scalar", "name": name_}
    ;)
end

# ─── public API ───────────────────────────────────────────────────────────────

# Parses a GraphQL SDL string and returns an array of type definitions.
def graphql_parse(input):
  let s = _gql_strip_comments(to_string(input))
  | let types      = _gql_find_defs(s, "type",      fn(b): _gql_parse_type_def(b, "type");)
  | let interfaces = _gql_find_defs(s, "interface", fn(b): _gql_parse_type_def(b, "interface");)
  | let inputs     = _gql_find_defs(s, "input",     fn(b): _gql_parse_type_def(b, "input");)
  | let enums      = _gql_find_defs(s, "enum",      fn(b): _gql_parse_enum_def(b);)
  | let unions     = _gql_find_defs(s, "union",     fn(b): _gql_parse_union_def(b);)
  | let scalars    = _gql_find_scalars(s)
  | types + interfaces + inputs + enums + unions + scalars
end

# Returns all type names defined in the schema.
def graphql_type_names(input):
  map(graphql_parse(input), fn(t): t["name"];)
end

# Returns the definition of a specific type by name.
def graphql_find_type(input, name_):
  first(filter(graphql_parse(input), fn(t): t["name"] == name_;))
end

# Returns all fields of a specific type.
def graphql_fields(input, type_name):
  let t = graphql_find_type(input, type_name)
  | if (is_none(t)): [] else: t["fields"]
end
